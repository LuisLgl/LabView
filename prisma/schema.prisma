generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 1. USUARIOS (Administradores e Monitores do Laboratório)
model Usuario {
  id         String   @id @default(uuid())
  nome       String
  email      String   @unique
  senha_hash String   @default("hash_default")
  perfil     String   @default("Administrador") // Administrador ou Monitor
  criado_em  DateTime @default(now())

  // Relacionamentos conforme Figura 1 do PDF
  alunosCadastrados      Aluno[]
  computadoresCadastrados Computador[]
  problemasRegistrados    ProblemaComputador[]

  @@map("USUARIOS")
}

// 2. ALUNOS (Alunos cadastrados que utilizam o laboratório)
model Aluno {
  id             String   @id // Matrícula
  nome           String
  email          String   @unique
  senha_hash     String   @default("hash_aluno")
  curso          String   @default("Sistemas de Informação")
  status         String   @default("ativo") // ativo ou suspenso
  cadastrado_por String
  criado_em      DateTime @default(now())

  // Relacionamentos conforme Figura 1 do PDF
  responsavel          Usuario                @relation(fields: [cadastrado_por], references: [id], onDelete: Cascade)
  acessosSala          ControleSala[]
  sessoesComputadores  ControleComputadores[]

  @@map("ALUNOS")
}

// 3. COMPUTADORES (Parque de equipamentos do laboratório)
model Computador {
  id             Int      @id @default(autoincrement())
  patrimonio     String   @unique
  nome_host      String
  status         String   @default("disponivel") // disponivel, ocupado, manutencao
  especificacoes String?
  cadastrado_por String

  // Relacionamentos conforme Figura 1 do PDF
  responsavel          Usuario                @relation(fields: [cadastrado_por], references: [id], onDelete: Cascade)
  sessoesComputadores  ControleComputadores[]
  problemas            ProblemaComputador[]

  @@map("COMPUTADORES")
}

// 4. CONTROLE_SALA (Registro de entrada e saída física dos alunos)
model ControleSala {
  id       String    @id @default(uuid())
  aluno_id String
  entrada  DateTime  @default(now())
  saida    DateTime?

  // Relacionamentos conforme Figura 1 do PDF
  aluno Aluno @relation(fields: [aluno_id], references: [id], onDelete: Cascade)

  @@map("CONTROLE_SALA")
}

// 5. CONTROLE_COMPUTADORES (Sessões de uso das máquinas pelos alunos)
model ControleComputadores {
  id            String    @id @default(uuid())
  aluno_id      String
  computador_id Int
  inicio_uso    DateTime  @default(now())
  fim_uso       DateTime?

  // Relacionamentos conforme Figura 1 do PDF
  aluno      Aluno      @relation(fields: [aluno_id], references: [id], onDelete: Cascade)
  computador Computador @relation(fields: [computador_id], references: [id], onDelete: Cascade)

  @@map("CONTROLE_COMPUTADORES")
}

// 6. PROBLEMAS_COMPUTADORES (Histórico de ocorrências e manutenção)
model ProblemaComputador {
  id             String    @id @default(uuid())
  computador_id  Int
  descricao      String
  data_registro  DateTime  @default(now())
  data_resolucao DateTime?
  status         String    @default("pendente") // pendente ou resolvido
  registrado_por String

  // Relacionamentos conforme Figura 1 do PDF
  computador  Computador @relation(fields: [computador_id], references: [id], onDelete: Cascade)
  responsavel Usuario    @relation(fields: [registrado_por], references: [id], onDelete: Cascade)

  @@map("PROBLEMAS_COMPUTADORES")
}
